{
  "name": "jason-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The browser UI the Jason runtime serves: one more client of its API.",
  "license": "MIT",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "package": "node scripts/package.mjs",
    "check": "tsc --noEmit && eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@preact/signals": "2.11.3",
    "preact": "11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.4",
    "@types/node": "26.6.5",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "eslint": "10.13.0",
    "happy-dom": "21.0.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  }
}
