<Project Sdk="Microsoft.NET.Sdk">
  <!-- The CLI is a pure client of the Runtime API. It may reference Jason.Contracts and the HTTP client
       only — never Jason.Runtime, EF Core or SQLite. This keeps "the CLI never touches the database" a
       compile-time property. -->
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Jason.Contracts/Jason.Contracts.csproj" />
  </ItemGroup>
  <!-- A friend assembly so a test reads a number the code decides rather than keeping a copy that could drift from
       it: how long the question to a descriptor found before a launch may take, and the block size the log reader
       reads a file backwards in. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Jason.Cli.Tests" />
  </ItemGroup>
  <!-- A test build, and only one built with -p:JasonTestBuild=true: the move into Jason Desktop then reads the signer and
       the requirement it holds the application to from the environment, so a proof on a runner can sign a test build of
       the application with that runner's own certificate. No release passes it; a guard holds it out of the release
       workflow and the package action. -->
  <PropertyGroup Condition="'$(JasonTestBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);JASON_TEST_BUILD</DefineConstants>
  </PropertyGroup>
  <!-- The plugins this repository ships, by their directories under plugins/, read from the tree at build time: a
       diagnostic bundle carries their ids by name and writes any other id as an alias. Read rather than typed, so the
       sources name no plugin and the list cannot drift from the directory. -->
  <ItemGroup>
    <ShippedPluginManifest Include="$(MSBuildThisFileDirectory)../../../plugins/**/plugin.yaml" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ShippedPluginDirectories</_Parameter1>
      <_Parameter2>@(ShippedPluginManifest->'%(RecursiveDir)', '|')</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
