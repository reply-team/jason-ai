<Project Sdk="Microsoft.NET.Sdk">
  <!-- For one file: the toast's WinRT interop calls COM vtables through function pointers, with no projection and no
       Windows-only target framework. It runs only in the short-lived toast-host child, never in the runtime. -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" />
    <!-- A manifest is the one file a plugin author writes by hand, so it is YAML. The reader lives here and nowhere else. -->
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Jason.Contracts/Jason.Contracts.csproj" />
  </ItemGroup>

  <!-- The plugin packages this build's release publishes beside its archives, carried for their content digest and their
       manifest's version and for nothing else (ReleasedPlugins): system.info says how the installed package stands
       against the release this runtime is. A directory glob and never a file list, so a file added to the package is in
       the binary; a path with a segment starting with a dot is left out, as the digest and the release's zip leave it out.
       A test holds the carried set to the tree. -->
  <ItemGroup>
    <EmbeddedResource Include="../../../plugins/reply/**/*" Exclude="../../../plugins/reply/**/.*;../../../plugins/reply/**/.*/**" LogicalName="ReleasedPlugins/reply/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <!-- A friend assembly, for the numbers its tests read from the code rather than copy, and for two internal test
       hooks, each there because what it holds open cannot otherwise be proved except by racing, and a racing proof
       of an anti-race is worth nothing.
       WorkDirectory's renames a role's tree under a launch; PluginInvoker's keeps an envelope write in flight
       past the cancellation meant to end it. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Jason.Runtime.Tests" />
  </ItemGroup>

</Project>
