<Project Sdk="Microsoft.NET.Sdk">
  <!-- DTOs, operation names, shared JSON options and the discovery contract shared by server and clients.
       Must stay free of server dependencies: no EF Core, no ASP.NET Core, no Serilog. -->

  <!-- The published operation contracts are embedded rather than copied, so the catalog the runtime enforces is
       the very file under docs/contracts/ that a plugin author reads. The Link fixes the resource name, which is
       what OperationCatalog looks for. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\docs\contracts\operations\*.json" Link="Operations\%(Filename)%(Extension)" />
    <!-- The delivery contracts are a family of their own: a document dropped among the operations would become a
         provider operation a work item could name, so they are read under a prefix of their own by DeliveryCatalog. -->
    <EmbeddedResource Include="..\..\..\docs\contracts\notifications\*.json" Link="Notifications\%(Filename)%(Extension)" />
    <!-- The events contracts are a third family: a read of an account belongs to no campaign, so it is neither an
         operation nor a delivery, and is read under a prefix of its own by EventsCatalog. -->
    <EmbeddedResource Include="..\..\..\docs\contracts\events\*.json" Link="Events\%(Filename)%(Extension)" />
    <!-- The named preferences are a fourth family: a fact about the client a person states is no work anybody performs,
         so it is read under a prefix of its own by PreferenceCatalog. -->
    <EmbeddedResource Include="..\..\..\docs\contracts\preferences\*.json" Link="Preferences\%(Filename)%(Extension)" />
    <!-- The provider block is one document every operation's failure of class `blocked` carries: no operation, delivery,
         read or preference, so it is read by name, by ProviderBlockContract. -->
    <EmbeddedResource Include="..\..\..\docs\contracts\block\*.json" Link="Blocks\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Friend assemblies so the tests that use the shared pattern timing read the form a schema pattern is compiled in
       from the validator's own rewrite, rather than learning it by compiling and matching the pattern under the real
       timeout. Both compile that timing. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Jason.Contracts.Tests" />
    <InternalsVisibleTo Include="Jason.Runtime.Tests" />
  </ItemGroup>

  <!-- And the application's tests, whose guard over the compiled product holds every start the door makes to the
       error mode it is made under (StartErrorMode). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Jason.App.Tests" />
  </ItemGroup>
</Project>
