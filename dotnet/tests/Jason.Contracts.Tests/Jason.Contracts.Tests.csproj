<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="../../src/Jason.Contracts/Jason.Contracts.csproj" />

    <!-- One disposable temporary directory for the whole suite: a second copy is a second thing to forget to
         delete, and this suite has paid for that once already. -->
    <Compile Include="../Jason.Runtime.Tests/TempTree.cs" Link="TempTree.cs" />

    <!-- The version this tree carries, read from the one file that says it, for the test that checks the stamp. -->
    <Compile Include="../Jason.Runtime.Tests/TreeVersion.cs" Link="TreeVersion.cs" />

    <!-- The suite's one timing that makes a pattern's match time out on demand, so no test has to be slow to show one. -->
    <Compile Include="../Jason.Runtime.Tests/TimingOut.cs" Link="TimingOut.cs" />

    <!-- The one rule against a test matching a sentence the system words in the machine's language: each test assembly reads itself. -->
    <Compile Include="../Jason.Runtime.Tests/SystemSentenceTests.cs" Link="SystemSentenceTests.cs" />
    <!-- The critical tier's attribute and its families, one vocabulary in every test assembly. -->
    <Compile Include="../Jason.Runtime.Tests/Critical.cs" Link="Critical.cs" />
    <!-- The critical tier's table and its guard: each test assembly holds its own column of the table to what it discovers. -->
    <Compile Include="../Jason.Runtime.Tests/CriticalTier.cs" Link="CriticalTier.cs" />
  </ItemGroup>
</Project>
