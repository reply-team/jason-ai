{
  "kind": "external_id_pinned",
  "version": 1,
  "since": "0.1.0",
  "summary": "A provider's identifier for a campaign or a contact was pinned for the first time, by the attempt that returned it, and is never overwritten.",
  "subscribable": true,
  "entities": {
    "campaign": { "at": "/campaign_id", "presence": "always" },
    "contact": { "at": "/contact_id", "presence": "sometimes" },
    "work_item": { "at": "/work_item_id", "presence": "always" },
    "attempt": { "at": "/attempt_id", "presence": "always" }
  },
  "field_since": {},
  "body": {
    "type": "object",
    "additionalProperties": false,
    "required": ["key", "old", "new"],
    "properties": {
      "key": {
        "type": "string",
        "pattern": "^(campaign|contact)/",
        "description": "What the identifier belongs to, `campaign` or `contact`, then the plugin's id and the identifier's kind, joined by slashes."
      },
      "old": { "type": "null" },
      "new": { "type": "string", "minLength": 1, "description": "The identifier the provider gave." }
    }
  }
}
