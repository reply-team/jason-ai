{
  "key": "goals",
  "version": 1,
  "summary": "What the campaign is for: the outcomes its roles steer each conversation towards, in the order they are worth trying, each with the moment it counts as reached in the person's words.",
  "value_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "array",
    "maxItems": 20,
    "items": {
      "type": "object",
      "required": ["id", "kind", "title", "reached_when", "order"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "kind": { "enum": ["meeting", "demo", "trial", "interested_reply", "purchase", "custom"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "reached_when": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "order": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    }
  },
  "distinct_by": "id"
}
