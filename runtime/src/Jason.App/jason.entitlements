<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The entitlements of the macOS executable, signed into it by the release's package action together with the hardened
  runtime notarization requires. The hardened runtime refuses what .NET does by design unless the signature says it may;
  these four keys are the set Microsoft documents for a .NET application under the hardened runtime, and nothing else
  is asked for. Whether the set can be trimmed is shown by a run of its own, never guessed.
-->
<plist version="1.0">
<dict>
  <!-- The JIT compiles methods into memory it maps for execution; without this the runtime cannot start. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- Some of the runtime's code paths make memory executable without the JIT's own mapping; Microsoft's set allows
       them rather than leave a path that fails only when it is taken. -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- The hardened runtime would otherwise drop the DYLD_ variables the dynamic loader reads, which is how a native
       library is pointed at when one has to be. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <!-- The native libraries the single-file bundle unpacks on its first run, SQLite's among them, are not signed by our
       team, and library validation would refuse to load them. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
