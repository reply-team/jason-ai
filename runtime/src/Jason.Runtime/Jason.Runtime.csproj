<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" />
    <!-- A manifest is the one file a plugin author writes by hand, so it is YAML. The reader lives here and nowhere else. -->
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Jason.Contracts/Jason.Contracts.csproj" />
  </ItemGroup>

  <!-- The only friend assembly in this repository. WorkDirectory carries one internal test hook, because the
       launcher's behaviour when a deployment renames a role's tree under it cannot otherwise be proved except
       by racing, and a racing proof of an anti-race is worth nothing. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Jason.Runtime.Tests" />
  </ItemGroup>

</Project>
