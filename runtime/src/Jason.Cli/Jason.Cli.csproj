<Project Sdk="Microsoft.NET.Sdk">
  <!-- The CLI is a pure client of the Runtime API. It may reference Jason.Contracts and the HTTP client
       only — never Jason.Runtime, EF Core or SQLite. This keeps "the CLI never touches the database" a
       compile-time property. -->
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Jason.Contracts/Jason.Contracts.csproj" />
  </ItemGroup>
  <!-- A friend assembly so a test reads a number the code decides rather than keeping a copy that could drift from
       it: how long the question to a descriptor found before a launch may take, and the block size the log reader
       reads a file backwards in. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Jason.Cli.Tests" />
  </ItemGroup>
</Project>
