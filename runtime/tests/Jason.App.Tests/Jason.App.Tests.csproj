<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <!-- Referencing the executable copies jason.dll and its runtimeconfig next to the tests, so end-to-end tests can spawn it. -->
    <ProjectReference Include="../../src/Jason.App/Jason.App.csproj" />
    <!-- The stand-in agent host, for the same reason: end-to-end work has to be performed by a real child process. -->
    <ProjectReference Include="../Jason.FakeAgentHost/Jason.FakeAgentHost.csproj" />
    <!-- The stand-in vendor CLI: the end-to-end plugin flow runs a real program through host.exec. -->
    <ProjectReference Include="../Jason.FakeProviderCli/Jason.FakeProviderCli.csproj" />
    <!-- The stand-in for the Reply CLI, whose apphost is named `reply`, so the official package's own manifest resolves to it rather than to anything the machine has installed. -->
    <ProjectReference Include="../Jason.ReplyCliStub/Jason.ReplyCliStub.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The canonical plugin package, kept in one place and linked into every test project that installs it. -->
    <None Include="../fixtures/plugins/**" LinkBase="Fixtures/plugins" CopyToOutputDirectory="PreserveNewest" />
    <!-- The marketplace package itself, linked beside the fixtures, so the golden path installs the same package an operator would. -->
    <None Include="../../../plugins/reply/**" LinkBase="Fixtures/plugins/reply" CopyToOutputDirectory="PreserveNewest" />
    <!-- One definition of what a Reply account is, shared with the runtime tests rather than copied: the file holds the store's shape, the call log and the instructions the stand-in reads. -->
    <Compile Include="../Jason.Runtime.Tests/Plugins/Reply/ReplyAccount.cs" Link="EndToEnd/ReplyAccount.cs" />
    <!-- One definition of the environment a spawned test runtime gets — its own data directory, and no update check — shared for the same reason: eight sites spawn one, and a variable spelled by hand in each is one a ninth forgets. -->
    <Compile Include="../Jason.Runtime.Tests/TestRuntimeEnvironment.cs" Link="EndToEnd/TestRuntimeEnvironment.cs" />
    <!-- One shell splitter for every guard in this repository that types a documented line. -->
    <Compile Include="../Jason.Cli.Tests/Documentation/ShellWords.cs" Link="Skills/ShellWords.cs" />
    <!-- The suite's one disposable temporary directory, rather than a second copy of the same idea. -->
    <Compile Include="../Jason.Runtime.Tests/TempTree.cs" Link="Skills/TempTree.cs" />
    <!-- The process table that launches nothing: a null seam falls back to the one that starts real processes. -->
    <Compile Include="../Jason.Cli.Tests/Process/FakeProcessControl.cs" Link="Skills/FakeProcessControl.cs" />
  </ItemGroup>
</Project>
