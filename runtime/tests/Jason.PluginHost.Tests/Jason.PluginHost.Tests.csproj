<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="../../src/Jason.PluginHost/Jason.PluginHost.csproj" />
    <!-- Referencing the stand-in vendor CLI copies Jason.FakeProviderCli.dll, its apphost and its runtimeconfig
         next to the tests, so host.exec can start a real foreign program. -->
    <ProjectReference Include="../Jason.FakeProviderCli/Jason.FakeProviderCli.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The canonical plugin package, kept in one place and linked into every test project that runs it. -->
    <None Include="../fixtures/plugins/**" LinkBase="Fixtures/plugins" CopyToOutputDirectory="PreserveNewest" />
    <!-- The one rule against a test matching a sentence the system words in the machine's language: each test assembly reads itself. -->
    <Compile Include="../Jason.Runtime.Tests/SystemSentenceTests.cs" Link="SystemSentenceTests.cs" />
    <!-- The reading of compiled calls the runtime's guards use, so the plugin host's own assembly is read the same way. -->
    <Compile Include="../Jason.Runtime.Tests/CompiledCalls.cs" Link="CompiledCalls.cs" />
  </ItemGroup>
</Project>
