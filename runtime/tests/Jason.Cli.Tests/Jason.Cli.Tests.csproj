<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="../../src/Jason.Cli/Jason.Cli.csproj" />

    <!-- The suite's one disposable temporary directory, rather than a second copy of the same idea. -->
    <Compile Include="../Jason.Runtime.Tests/TempTree.cs" Link="TempTree.cs" />

    <!-- And the suite's one controllable clock, for the same reason: a rollback's waits are on the clock it is
         handed, and a test that let them run on the real one would spend a minute proving a message. -->
    <Compile Include="../Jason.Runtime.Tests/FixedClock.cs" Link="FixedClock.cs" />

    <!-- And the one stand-in for the product's address: a redirect in front of a release's files, which the update
         check and both install scripts are run through. -->
    <Compile Include="../Jason.Runtime.Tests/LoopbackReleases.cs" Link="LoopbackReleases.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- What the repository teaches somebody to type, linked beside the tests that hand every printed command to the real parser. -->
    <None Include="../../../skills/**/SKILL.md" LinkBase="Skills" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../docs/golden-path.md" LinkBase="Documentation" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
