{
  "name": "jason-desktop",
  "productName": "Jason",
  "private": true,
  "version": "0.0.0",
  "description": "Jason as a desktop application: a window on the installation the jason command line uses.",
  "license": "MIT",
  "author": "Reply",
  "main": "lib/main.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"test/*.test.ts\"",
    "prepare:bundle": "node scripts/prepare.mjs",
    "notices": "node scripts/notices.mjs",
    "dev": "npm run build && electron ."
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "electron": "44.7.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
